{
  "framework": "nextjs",
  "ignoreCommand": "bash scripts/build-check.sh",
  "installCommand": "npm install --no-audit --no-fund",
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
